# Iconoclast.ai server configuration.
# Optional model default. Each visitor supplies their own OpenAI API key in the UI.
# OPENAI_API_KEY is intentionally ignored by this public prototype.
OPENAI_MODEL=gpt-6.1-sol

# Optional: base64-encoded 32 random bytes. Enables encrypted remembered-key cookies.
# Set this only in .env.local or Vercel's server environment, never NEXT_PUBLIC_*.
# Keep it stable across deployments; rotation invalidates all saved connections.
ICONIFY_KEY_ENCRYPTION_SECRET=
